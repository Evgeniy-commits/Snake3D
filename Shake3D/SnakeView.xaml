<Window x:Class="Snake3D.SnakeView"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake 3D" Height="800" Width="1000"
        Background="#1E1E2E"
        WindowStartupLocation="CenterScreen">
	<Grid>
		<Grid.RowDefinitions>
			<RowDefinition Height="Auto"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="Auto"/>
		</Grid.RowDefinitions>

		<StackPanel Grid.Row="0"
                    HorizontalAlignment="Left"
                    Margin="10" Orientation="Horizontal">
			<TextBlock Text="Счёт: " Foreground="White"
                       FontSize="18" FontWeight="Bold"/>
			<TextBlock x:Name="ScoreText" Text="0" Foreground="#7EE787"
                       FontSize="18" FontWeight="Bold"/>
		</StackPanel>

		<WindowsFormsHost x:Name="ViewportHost" 
						  Grid.Row="1"
						  HorizontalAlignment="Stretch"
						  VerticalAlignment="Stretch"/>
		
		<TextBlock x:Name="StatusText" Grid.Row="2"
                   Text="Нажмите SPACE для старта"
                   Foreground="#9A9A9A" FontSize="14"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>
	</Grid>
</Window>