<Window x:Class="Snake3D.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake3D" Height="420" Width="440"
        WindowStartupLocation="CenterOwner"
        Background="#1E1E2E">
	<Window.Resources>
		<!-- Единый стиль зелёных кнопок: цвет совпадает с заголовком -->
		<Style x:Key="MenuButton" TargetType="Button">
			<Setter Property="Background" Value="#33D17A"/>
			<Setter Property="Foreground" Value="#101828"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Margin" Value="0,12,0,0"/>
			<Setter Property="Cursor" Value="Hand"/>
		</Style>
	</Window.Resources>

	<StackPanel Margin="28">
		<TextBlock Text="Crystall Hunter" FontSize="36" FontWeight="Bold"
                   Foreground="#33D17A" HorizontalAlignment="Center"
                   Margin="0,8,0,8"/>

		<Button x:Name="BtnStart" Content="Начать игру"
                Style="{StaticResource MenuButton}" Click="BtnStart_Click"/>

		<!-- «Опции» — обычная кнопка: по клику открывает Popup под собой -->
		<Button x:Name="BtnOptions" Content="Опции"
                Style="{StaticResource MenuButton}" Click="BtnOptions_Click"/>

		<!-- Popup привязан к кнопке: закрывается по клику мимо (StaysOpen=False) -->
		<Popup x:Name="OptionsPopup"
               PlacementTarget="{Binding ElementName=BtnOptions}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
			<Border Background="#252538" BorderBrush="#33D17A" BorderThickness="1"
                    CornerRadius="8" Padding="18" Width="360">
				<StackPanel TextElement.Foreground="#E6E6F0">
					<CheckBox x:Name="OptCockpit" Content="Вид: кабина (иначе — обзор)"/>
					<CheckBox x:Name="OptTap" Content="Управление: тап-поворот (иначе — плавное)"
              Margin="0,6,0,0"/>
					<CheckBox x:Name="OptWalls" Content="Стены включены" IsChecked="True"
              Margin="0,6,0,0"/>

					<TextBlock Text="Скорость игры" Margin="0,14,0,2"/>
					<Slider x:Name="OptSpeed" Minimum="0.5" Maximum="15.0" Value="1.0"
            TickFrequency="0.25" IsSnapToTickEnabled="True"/>

					<TextBlock Text="Кристаллов на поле" Margin="0,14,0,2"/>
					<Slider x:Name="OptCrystals" Minimum="1" Maximum="1000" Value="200"
            TickFrequency="1" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="CrystalLabel" FontSize="12" Foreground="#9AA0B4"
               Margin="0,2,0,0"/>

					<TextBlock Text="Мин на поле" Margin="0,14,0,2"/>
					<Slider x:Name="OptMines" Minimum="0" Maximum="500" Value="100"
            TickFrequency="1" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="MineLabel" FontSize="12" Foreground="#9AA0B4"
               Margin="0,2,0,0"/>

					<TextBlock Text="Размер арены" Margin="0,14,0,2"/>
					<Slider x:Name="OptArena" Minimum="60" Maximum="1000" Value="120"
            TickFrequency="10" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="ArenaLabel" FontSize="12" Foreground="#9AA0B4"
               Margin="0,2,0,0"/>

					<TextBlock Text="Шаг сетки" Margin="0,14,0,2"/>
					<Slider x:Name="OptGrid" Minimum="1.0" Maximum="10" Value="2.5"
            TickFrequency="0.5" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="GridLabel" FontSize="12" Foreground="#9AA0B4"
               Margin="0,2,0,0"/>
				</StackPanel>
			</Border>
		</Popup>

		<Button x:Name="BtnExit" Content="Выход"
                Style="{StaticResource MenuButton}" Click="BtnExit_Click"/>
	</StackPanel>
</Window>