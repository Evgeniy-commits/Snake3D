<Window x:Class="Snake3D.MenuWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Snake3D" Height="500" Width="500"
        WindowStartupLocation="CenterOwner">
	<Window.Background>
		<ImageBrush ImageSource="/image/Shatl.jpg" Stretch="UniformToFill"/>
	</Window.Background>
	<Window.Resources>
		<Style x:Key="MenuButton" TargetType="Button">
			<Setter Property="Background" Value="#A01A1E38"/>
			<!-- тёмный индиго, ~63% прозрачности -->
			<Setter Property="Foreground" Value="#E6E9F5"/>
			<Setter Property="FontSize" Value="18"/>
			<Setter Property="FontWeight" Value="SemiBold"/>
			<Setter Property="Height" Value="38"/>
			<Setter Property="Margin" Value="0,12,0,0"/>
			<Setter Property="Cursor" Value="Hand"/>
			<Setter Property="BorderBrush" Value="#5A6B9E"/>
			<!-- холодная стальная кайма -->
			<Setter Property="BorderThickness" Value="1"/>

			<Setter Property="Effect">
				<Setter.Value>
					<DropShadowEffect Color="#3A4E8C" BlurRadius="12"
                                  ShadowDepth="3" Opacity="0.6"/>
				</Setter.Value>
			</Setter>

			<Style.Triggers>
				<Trigger Property="IsMouseOver" Value="True">
					<Setter Property="Background" Value="#AA22305A"/>
					<!-- заливка та же, что в покое -->
					<Setter Property="BorderBrush" Value="#8FB0FF"/>
					<!-- светится только контур -->
					<Setter Property="Foreground" Value="#FFFFFF"/>
				</Trigger>
				<Trigger Property="IsPressed" Value="True">
					<Setter Property="Background" Value="#FF1B2140"/>
					<Setter Property="Foreground" Value="#8FB0FF"/>
				</Trigger>
			</Style.Triggers>
		</Style>
	</Window.Resources>

	<StackPanel Margin="28">
		<TextBlock Text="Crystall Hunter" FontSize="36" FontWeight="Bold"
           Foreground="#E6E9F5" HorizontalAlignment="Center"
           Margin="0,8,0,8">
			<TextBlock.Effect>
				<DropShadowEffect Color="#8FB0FF" BlurRadius="14" ShadowDepth="0" Opacity="0.9"/>
			</TextBlock.Effect>
		</TextBlock>

		<Button x:Name="BtnContinue" Content="Продолжить" 
				Style="{StaticResource MenuButton}" Click="BtnContinue_Click"/>
		<Button x:Name="BtnHunt" Content="Свободная охота" 
				Style="{StaticResource MenuButton}" Click="BtnHunt_Click"/>
		<Button x:Name="BtnMission" Content="Миссия" 
				Style="{StaticResource MenuButton}" Click="BtnMission_Click"/>

		<!-- «Опции» — обычная кнопка: по клику открывает Popup под собой -->
		<Button x:Name="BtnOptions" Content="Опции"
                Style="{StaticResource MenuButton}" Click="BtnOptions_Click"/>

		<!-- Popup привязан к кнопке: закрывается по клику мимо (StaysOpen=False) -->
		<Popup x:Name="OptionsPopup"
               PlacementTarget="{Binding ElementName=BtnOptions}"
               Placement="Bottom" StaysOpen="False" AllowsTransparency="True">
			<Border Background="#E6181C30" BorderBrush="#5A6B9E" BorderThickness="1"
						CornerRadius="8" Padding="18" Width="360">
				<StackPanel TextElement.Foreground="#9AA6C8">
					<CheckBox x:Name="OptCockpit" Content="Вид: кабина (иначе — обзор)" Foreground="#9AA6C8"/>
					<CheckBox x:Name="OptTap" Content="Управление: тап-поворот (иначе — плавное)"
						 Foreground="#9AA6C8" Margin="0,6,0,0"/>
					<CheckBox x:Name="OptWalls" Content="Стены включены" IsChecked="True"
						Foreground="#9AA6C8" Margin="0,6,0,0"/>

					<TextBlock Text="Скорость игры" Margin="0,14,0,2" Foreground="#9AA6C8"/>
					<Slider x:Name="OptSpeed" Minimum="0.5" Maximum="15.0" Value="1.0"
						TickFrequency="0.25" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="SpeedLabel" FontSize="12" Foreground="#7E8AB0" Margin="0,2,0,0"/>
					
					<TextBlock Text="Кристаллов на поле" Margin="0,14,0,2" Foreground="#9AA6C8"/>
					<Slider x:Name="OptCrystals" Minimum="1" Maximum="1000" Value="200"
						TickFrequency="1" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="CrystalLabel" FontSize="12" Foreground="#7E8AB0" Margin="0,2,0,0"/>

					<TextBlock Text="Мин на поле" Margin="0,14,0,2" Foreground="#9AA6C8"/>
					<Slider x:Name="OptMines" Minimum="0" Maximum="500" Value="100"
						TickFrequency="1" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="MineLabel" FontSize="12" Foreground="#7E8AB0" Margin="0,2,0,0"/>

					<TextBlock Text="Размер арены" Margin="0,14,0,2" Foreground="#9AA6C8"/>
					<Slider x:Name="OptArena" Minimum="60" Maximum="1000" Value="120"
                TickFrequency="10" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="ArenaLabel" FontSize="12" Foreground="#7E8AB0" Margin="0,2,0,0"/>

					<TextBlock Text="Шаг сетки" Margin="0,14,0,2" Foreground="#9AA6C8"/>
					<Slider x:Name="OptGrid" Minimum="1.0" Maximum="10" Value="2.5"
                TickFrequency="0.5" IsSnapToTickEnabled="True"/>
					<TextBlock x:Name="GridLabel" FontSize="12" Foreground="#7E8AB0" Margin="0,2,0,0"/>
				</StackPanel>
			</Border>
		</Popup>

		<Button x:Name="BtnScores" Content="Рекорды" 
				Style="{StaticResource MenuButton}" Click="BtnScores_Click"/>
		<Button x:Name="BtnExit" Content="Выход"
                Style="{StaticResource MenuButton}" Click="BtnExit_Click"/>
	</StackPanel>
</Window>