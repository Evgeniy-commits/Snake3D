<Window x:Class="Snake3D.HighScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекорды" Height="380" Width="420"
        WindowStartupLocation="CenterOwner" Background="#1E1E2E">
	<StackPanel Margin="16" TextElement.Foreground="#E6E6F0">
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<RadioButton x:Name="TabHunt" Content="Свободная охота"
                         Foreground="#33D17A" Checked="Tab_Checked" IsChecked="True"/>
			<RadioButton x:Name="TabMission" Content="Миссия"
                         Foreground="#33D17A" Margin="20,0,0,0" Checked="Tab_Checked"/>
		</StackPanel>
		<DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
          HeadersVisibility="Column" CanUserAddRows="False"
          Background="#33D17A" BorderBrush="#33D17A"
          RowBackground="#2E2E44" AlternatingRowBackground="#35354F"
          Foreground="#E6E6F0" GridLinesVisibility="Horizontal"
          HorizontalGridLinesBrush="#3E3E5A">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="80"/>
				<DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="90"/>
				<DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="150"/>
			</DataGrid.Columns>

			<!-- Заголовки столбцов: тоже зелёная тема вместо белого -->
			<DataGrid.ColumnHeaderStyle>
				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Background" Value="#33D17A"/>
					<Setter Property="Foreground" Value="#101828"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Padding" Value="8,4"/>
					<Setter Property="BorderBrush" Value="#1E1E2E"/>
				</Style>
			</DataGrid.ColumnHeaderStyle>

			<!-- Кнопка в правом нижнем углу (пустой угол таблицы) и скроллбары -->
			<DataGrid.Resources>
				<Style TargetType="Button">
					<Setter Property="Background" Value="#33D17A"/>
				</Style>
			</DataGrid.Resources>
		</DataGrid>
	</StackPanel>
</Window>
