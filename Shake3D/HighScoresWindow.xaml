<Window x:Class="Snake3D.HighScoresWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Рекорды" Height="380" Width="420"
        WindowStartupLocation="CenterOwner">
	<Window.Background>
		<ImageBrush ImageSource="/image/space-shuttle.jpg" Stretch="UniformToFill"/>
	</Window.Background>
	<StackPanel Margin="16" TextElement.Foreground="#E6E9F5">
		<StackPanel Orientation="Horizontal" Margin="0,0,0,10">
			<RadioButton x:Name="TabHunt" Content="Свободная охота"
                         Foreground="#8FB0FF" Checked="Tab_Checked" IsChecked="True"/>
			<RadioButton x:Name="TabMission" Content="Миссия"
                         Foreground="#8FB0FF" Margin="20,0,0,0" Checked="Tab_Checked"/>
		</StackPanel>
		<DataGrid x:Name="Grid" AutoGenerateColumns="False" IsReadOnly="True"
                  HeadersVisibility="Column" CanUserAddRows="False"
                  Background="#1A1E38" BorderBrush="#5A6B9E"
                  RowBackground="#1E2340" AlternatingRowBackground="#242A4C"
                  Foreground="#E6E9F5" GridLinesVisibility="Horizontal"
                  HorizontalGridLinesBrush="#3A4066">
			<DataGrid.Columns>
				<DataGridTextColumn Header="Очки" Binding="{Binding Score}" Width="80"/>
				<DataGridTextColumn Header="Время" Binding="{Binding TimeText}" Width="90"/>
				<DataGridTextColumn Header="Дата" Binding="{Binding Date}" Width="150"/>
			</DataGrid.Columns>

			<DataGrid.ColumnHeaderStyle>
				<Style TargetType="DataGridColumnHeader">
					<Setter Property="Background" Value="#242A4C"/>
					<Setter Property="Foreground" Value="#8FB0FF"/>
					<Setter Property="FontWeight" Value="SemiBold"/>
					<Setter Property="Padding" Value="8,4"/>
					<Setter Property="BorderBrush" Value="#12152A"/>
				</Style>
			</DataGrid.ColumnHeaderStyle>

			<DataGrid.Resources>
				<Style TargetType="Button">
					<Setter Property="Background" Value="#242A4C"/>
				</Style>
			</DataGrid.Resources>
		</DataGrid>
	</StackPanel>
</Window>